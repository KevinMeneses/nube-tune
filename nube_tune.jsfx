  );
  (_pp >= tv0 && _pp <= tv0 + tvs) ? ( gfx_set(1, 1, 1, (_ps & 1) ? 0.8 : 0.35); _xx = t2x(_pp); gfx_line(_xx, dy, _xx, dy + dh - 1); );
  // regla de compases
