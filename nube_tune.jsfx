  (_pp >= tv0 && _pp <= tv0 + tvs) ? ( gfx_set(1, 1, 1, 0.9); _xx = t2x(_pp); gfx_triangle(_xx - 5 * SC, dy, _xx + 5 * SC, dy, _xx, dy + 7 * SC); );
  !tfollow ? (
