desc:Nube Tune - afinador automatico (autotune: escalas, velocidad, humanizar, flex, formantes, MIDI)
//tags: autotune pitch correction tuner vocal formant psola scale midi
//author: Kev Meneses + Claude (Claude Code)
//license: GPL-3.0-or-later
//version: 1.0.0

slider1:20<0,400,1>-Velocidad (ms; 0 = robot)
slider2:0<0,100,1>-Humanizar (%)
slider3:0<0,100,1>-Flex (%)
slider4:0<-12,12,0.1>-Formantes (st)
slider5:0<-24,24,1>-Transponer (st)
slider6:440<415,465,0.1>-La de referencia (A4 Hz)
slider7:0<0,100,1>-Vibrato profundidad (cents)
slider8:5.5<1,10,0.1>-Vibrato velocidad (Hz)
slider9:300<0,1500,10>-Vibrato retardo (ms)
slider10:100<0,100,1>-Mezcla (%)
slider11:0<-12,12,0.1>-Salida (dB)
slider12:0<0,11,1{C,C#,D,D#,E,F,F#,G,G#,A,A#,B}>-Tonalidad
slider13:0<0,12,1{Cromatica,Mayor,Menor,Menor armonica,Menor melodica,Pentatonica mayor,Pentatonica menor,Blues,Dorica,Frigia,Lidia,Mixolidia,Personalizada}>-Escala
slider14:4095<0,4095,1>-Notas personalizadas (bits C..B)
slider15:1<0,3,1{Soprano / Alto (desde 120 Hz),Tenor / voz media (desde 85 Hz),Baritono / Bajo (desde 65 Hz),Instrumento grave (desde 40 Hz)}>-Rango de voz
slider16:50<0,100,1>-Sensibilidad (%)
slider17:-50<-80,-20,1>-Puerta (dB)
slider18:0<0,1,1{Preservar,Siguen el tono}>-Formantes al transponer
slider19:0<0,2,1{Apagado,Notas tocadas = escala,Nota exacta}>-MIDI
slider20:0<0,1,1{No,Escuchando}>-Aprender tonalidad
slider21:0<0,13,1{-,Natural - correccion suave,Pop moderno,Hard tune - efecto robot,Trap melodico,Balada - respeta el vibrato,Solo centrar notas largas,Octava abajo,Octava arriba,Voz de monstruo,Ardilla,Vibrato agregado,Doble afinado (mezcla 50%),Por defecto}>-Cargar preset
slider22:0<0,1000000,1>-Diagnostico (interno)

in_pin:Entrada L
in_pin:Entrada R
out_pin:Salida L
out_pin:Salida R

options:gfx_hz=60 no_meter

@init
gfx_ext_retina = 1;

// ---------------------------------------------------------------- memoria
RB = 32768; RBM = RB - 1;
inL = 0; inR = 32768;                      // anillos de entrada
fA = 65536; fB = 81920;                    // FFT (no cruzan un limite de 65536)
dp = 98304; cs = 106496;                   // YIN: d' y energia acumulada
NMK = 4096; MKM = NMK - 1; mk = 131072;    // marcas de analisis (posiciones)
NFR = 1024; NFM = NFR - 1; frIn = 135168; frOut = 136192;   // cuadros: f entrada / f salida (Hz, 0 = sin voz)
NG = 16; gS = 137216; gA = 137232; gLo = 137248; gRo = 137264; gFr = 137280; gG = 137296; gOn = 137312;
NH = 4096; NHM = NH - 1; hIn = 138000; hOut = 142096; hTg = 146192;   // historial de la grafica
hitmem = 151000;
held = 153000; khist = 153200; kprof = 153300;
inM = 196608; rcor = 229376;              // anillo mono y correlaciones de refine()

// ---------------------------------------------------------------- utilidades
function clamp(x, a, b) ( x < a ? a : x > b ? b : x );
function db2a(x) ( 10 ^ (x / 20) );
function nlin(v, a, b) ( (v - a) / (b - a) );
function dlin(n, a, b) ( a + (b - a) * n );
function log2_(x) ( log(x) * 1.4426950408889634 );
function pcl(n) ( n - floor(n / 12) * 12 );
function bit(m, i) ( (m >> i) & 1 );

function sset(i, v)
(
  i == 1 ? ( slider1 = v; slider_automate(slider1); ) : i == 2 ? ( slider2 = v; slider_automate(slider2); ) :
  i == 3 ? ( slider3 = v; slider_automate(slider3); ) : i == 4 ? ( slider4 = v; slider_automate(slider4); ) :
  i == 5 ? ( slider5 = v; slider_automate(slider5); ) : i == 6 ? ( slider6 = v; slider_automate(slider6); ) :
  i == 7 ? ( slider7 = v; slider_automate(slider7); ) : i == 8 ? ( slider8 = v; slider_automate(slider8); ) :
  i == 9 ? ( slider9 = v; slider_automate(slider9); ) : i == 10 ? ( slider10 = v; slider_automate(slider10); ) :
  i == 11 ? ( slider11 = v; slider_automate(slider11); ) : i == 12 ? ( slider12 = v; slider_automate(slider12); ) :
  i == 13 ? ( slider13 = v; slider_automate(slider13); ) : i == 14 ? ( slider14 = v; slider_automate(slider14); ) :
  i == 15 ? ( slider15 = v; slider_automate(slider15); ) : i == 16 ? ( slider16 = v; slider_automate(slider16); ) :
  i == 17 ? ( slider17 = v; slider_automate(slider17); ) : i == 18 ? ( slider18 = v; slider_automate(slider18); ) :
  i == 19 ? ( slider19 = v; slider_automate(slider19); ) : i == 20 ? ( slider20 = v; slider_automate(slider20); ) :
  i == 21 ? ( slider21 = v; slider_automate(slider21); );
);

// ---------------------------------------------------------------- escalas (bits desde la tonica)
NSCALES = 13;
function scale_bits(s)
(
  s == 0 ? 4095 :
  s == 1 ? 2741 :     // mayor            0 2 4 5 7 9 11
  s == 2 ? 1453 :     // menor natural    0 2 3 5 7 8 10
  s == 3 ? 2477 :     // menor armonica   0 2 3 5 7 8 11
  s == 4 ? 2733 :     // menor melodica   0 2 3 5 7 9 11
  s == 5 ? 661 :      // penta mayor      0 2 4 7 9
  s == 6 ? 1193 :     // penta menor      0 3 5 7 10
  s == 7 ? 1257 :     // blues            0 3 5 6 7 10
  s == 8 ? 1709 :     // dorica           0 2 3 5 7 9 10
  s == 9 ? 1451 :     // frigia           0 1 3 5 7 8 10
  s == 10 ? 2773 :    // lidia            0 2 4 6 7 9 11
  s == 11 ? 1717 :    // mixolidia        0 2 4 5 7 9 10
  4095;
);
// mascara absoluta (bit 0 = C) de la tonalidad k con la escala s
function make_mask(k, s) local(b, m, i)
(
  b = scale_bits(s); m = 0; i = 0;
  loop(12, bit(b, i) ? m |= 1 << pcl(i + k); i += 1; );
  m;
);
function eff_mask() ( slider13 == 12 ? slider14 : make_mask(slider12, slider13); );

// ---------------------------------------------------------------- parametros
function reset_engine() local(k)
(
  memset(gOn, 0, NG);
  fcount = 0; fc0 = 0; hopc = 0;
  t0_ = nin - 1 - LAT;
  mcount = 0; mi = 0;
  am = t0_ + 1 - TU; mk[0] = am; mcount = 1;
  am = t0_ + 1;      mk[1] = am; mcount = 2; amT = TU; am_v = 0;
  s_next = am; planned = 0;
  sh = 0; cur_t = -1; unv = 1000; held_t = 0; held_v = 0; vph = 0;
  k = 0; loop(NFR, frIn[k] = frOut[k] = 0; k += 1; );
);

function update_params() local(fmin, fmax, nl)
(
  retune_s = slider1 * 0.001;
  human = slider2 * 0.01;
  flex = slider3 * 0.01;
  fmul = 2 ^ (slider4 / 12);
  transp = slider5;
  a4 = slider6;
  vdepth = slider7 * 0.01; vrate = slider8; vdelay = slider9 * 0.001;
  mix_t = slider10 * 0.01;
  og_t = db2a(slider11);
  emask = eff_mask(); emask == 0 ? emask = 4095;
  vthr = 0.10 + 0.0035 * slider16;               // 0.10 .. 0.45 (umbral de voz de YIN)
  gate = db2a(slider17);
  keepform = slider18 == 0;
  midimode = slider19;
  learn = slider20;
  fmin = slider15 == 0 ? 120 : slider15 == 1 ? 85 : slider15 == 2 ? 65 : 40;
  fmax = slider15 == 0 ? 1400 : slider15 == 1 ? 1100 : slider15 == 2 ? 800 : 700;
  nl = floor(srate / fmin);
  nl != PMAX || srate != last_sr ? (
    last_sr = srate;
    PMAX = nl; WIN = PMAX; N2 = 2 * PMAX;
    NFFT = 64; while (NFFT < N2) ( NFFT *= 2; );
    TMIN = max(floor(srate / fmax), 4);
    HOP = floor(srate * 256 / 48000 + 0.5);
    TU = floor(srate * 0.005);
    LAT = ceil(max(2.62 * PMAX + 6, 2.2 * PMAX + HOP + 4));
    pdc_delay = LAT; pdc_bot_ch = 0; pdc_top_ch = 2;
    reset_engine();
  );
);

// ---------------------------------------------------------------- lectura del anillo (Hermite)
function herm(buf, u) local(i, f, xm1, x0, x1, x2, c1, c2, c3)
(
  i = floor(u); f = u - i;
  xm1 = buf[(i - 1) & RBM]; x0 = buf[i & RBM]; x1 = buf[(i + 1) & RBM]; x2 = buf[(i + 2) & RBM];
  f == 0 ? x0 : (
    c1 = 0.5 * (x1 - xm1); c2 = xm1 - 2.5 * x0 + 2 * x1 - 0.5 * x2; c3 = 0.5 * (x2 - xm1) + 1.5 * (x0 - x1);
    ((c3 * f + c2) * f + c1) * f + x0;
  );
);

// valor interpolado de un arreglo de cuadros en la posicion x (Hz; 0 = sin voz)
function lookf(x, arr) local(fi, i, t, a, b)
(
  fcount < 2 ? 0 : (
    fi = (x - fc0) / HOP; i = floor(fi); t = fi - i;
    i > fcount - 2 ? ( i = fcount - 2; t = 1; );
    i < fcount - NFR + 2 ? ( i = fcount - NFR + 2; t = 0; );
    i < 0 ? ( i = 0; t = 0; );
    a = arr[i & NFM]; b = arr[(i + 1) & NFM];
    (a > 0 && b > 0) ? a + (b - a) * t : t < 0.5 ? a : b;
  );
);

// ---------------------------------------------------------------- correccion (una vez por cuadro)
function allowed(n, m) ( bit(m, pcl(n)); );
function nearest(p, m) local(b, d, c, best, bd)
(
  b = floor(p + 0.5); best = -1; bd = 100; d = -7;
  loop(15, c = b + d; (allowed(c, m) && abs(c - p) < bd) ? ( bd = abs(c - p); best = c; ); d += 1; );
  (cur_t >= 0 && allowed(cur_t, m) && abs(p - cur_t) < bd + 0.1) ? best = cur_t;
  best < 0 ? b : best;
);

function correct(voiced, f, rms) local(p, m, q, d, w, tgt, tau, k, po, ramp, vib, i)
(
  voiced ? (
    p = 69 + 12 * log2_(f / a4);
    unv * HOP > 0.08 * srate ? ( sh = 0; held_v = 0; cur_t = -1; vph = 0; );
    unv = 0;
    learn ? ( i = pcl(floor(p + 0.5)); khist[i] += min(rms * 30, 1); );
    m = learn ? 4095 : (midimode == 1 && held_mask) ? held_mask : emask;
    q = (midimode == 2 && midi_last >= 0 && !learn) ? midi_last : nearest(p, m);
    q != cur_t ? ( cur_t = q; held_t = 0; );
    d = q - p;
    w = (flex > 0 && !(midimode == 2 && midi_last >= 0)) ? clamp((0.5 - abs(d)) / (flex * 0.5), 0, 1) : 1;
    tgt = d * w;
    tau = retune_s + human * 0.4 * clamp((held_t * HOP / srate - 0.08) / 0.25, 0, 1);
    k = tau < 0.0003 ? 1 : 1 - exp(-HOP / (tau * srate));
    sh += (tgt - sh) * k;
    vdepth > 0 ? (
      vph += 2 * $pi * vrate * HOP / srate; vph > 2 * $pi ? vph -= 2 * $pi;
      ramp = clamp((held_v * HOP / srate - vdelay) / 0.25, 0, 1);
      vib = vdepth * ramp * sin(vph);
    ) : ( vib = 0; );
    po = p + sh + transp + vib;
    held_t += 1; held_v += 1;
    cor_p = p; cor_q = q; cor_o = po; cor_sh = sh;
    a4 * 2 ^ ((po - 69) / 12);
  ) : (
    unv += 1;
    cor_p = -1; cor_o = -1;
    0;
  );
);

// ---------------------------------------------------------------- deteccion (YIN con la FFT), cada HOP muestras
function detect() local(st, j, x, e0, scl, tau, cm, d, best, a0, a1, a2, den, tt, ar, ai, br, bi, rms, voiced, fi, fo, r, lo, hi, b2)
(
  st = nin - N2;
  cs[0] = 0; j = 0;
  loop(N2,
    x = inM[(st + j) & RBM];
    fB[j] = x; fA[j] = j < WIN ? x : 0;
    cs[j + 1] = cs[j] + x * x;
    j += 1;
  );
  e0 = cs[WIN];
  rms = sqrt(e0 / WIN);
  voiced = 0; fi = 0;
  rms > gate && rms > 0.00001 ? (
    memset(fA + N2, 0, NFFT - N2); memset(fB + N2, 0, NFFT - N2);
    fft_real(fA, NFFT); fft_real(fB, NFFT);
    fA[0] *= fB[0]; fA[1] *= fB[1];
    j = 2;
    loop(NFFT / 2 - 1,
      ar = fA[j]; ai = fA[j + 1]; br = fB[j]; bi = fB[j + 1];
      fA[j] = ar * br + ai * bi; fA[j + 1] = ar * bi - ai * br;
      j += 2;
    );
    ifft_real(fA, NFFT);
    scl = fA[0] != 0 ? e0 / fA[0] : 0;
    cm = 0; dp[0] = 1; tau = 1;
    loop(PMAX,
      d = e0 + (cs[tau + WIN] - cs[tau]) - 2 * fA[tau] * scl;
      d < 0 ? d = 0;
      cm += d;
      dp[tau] = cm > 0 ? d * tau / cm : 1;
      tau += 1;
    );
    best = 0; tau = TMIN;
    while (best == 0 && tau < PMAX - 1) (
      dp[tau] < 0.12 ? (
        while (tau < PMAX - 2 && dp[tau + 1] < dp[tau]) ( tau += 1; );
        best = tau;
      ) : tau += 1;
    );
    best == 0 ? (
      best = TMIN; tau = TMIN;
      loop(PMAX - 1 - TMIN, dp[tau] < dp[best] ? best = tau; tau += 1; );
    );
    // proteccion de octava: si salta justo al doble o a la mitad y el periodo anterior sigue siendo un
    // buen minimo, se queda con el anterior (las consonantes y los armonicos fuertes engañan a YIN)
    prev_tau > 0 ? (
      r = best / prev_tau;
      (abs(r - 2) < 0.16 || abs(r - 0.5) < 0.04 || abs(r - 3) < 0.2 || abs(r - 0.333) < 0.03) ? (
        lo = max(floor(prev_tau * 0.94), TMIN + 1); hi = min(ceil(prev_tau * 1.06), PMAX - 3);
        b2 = lo; tau = lo; loop(hi - lo + 1, dp[tau] < dp[b2] ? b2 = tau; tau += 1; );
        dp[b2] < vthr ? best = b2;
      );
    );
    a0 = dp[best - 1]; a1 = dp[best]; a2 = dp[best + 1];
    den = a0 - 2 * a1 + a2;
    tt = best + (den > 0 ? clamp(0.5 * (a0 - a2) / den, -0.5, 0.5) : 0);
    det_ap = a1;
    voiced = a1 < vthr && best > TMIN && best < PMAX - 2;
    voiced ? fi = srate / tt;
    prev_tau = voiced ? best : 0;
  ) : ( det_ap = 1; prev_tau = 0; );
  det_rms = rms;
  fo = correct(voiced, fi, rms);
  fcount == 0 ? fc0 = st + 0.4 * N2;
  frIn[fcount & NFM] = fi; frOut[fcount & NFM] = fo;
  fcount += 1;
  // historial para la grafica
  hIn[hw] = cor_p; hOut[hw] = cor_o; hTg[hw] = voiced ? cor_q : -1;
  hw = (hw + 1) & NHM;
);

// ---------------------------------------------------------------- PSOLA: planear y activar granos
function plan() local(s, a, la, ra, fo, fi, ratio, fr, e, dens, ts)
(
  s = s_next;
  while (mi + 1 < mcount && abs(mk[(mi + 1) & MKM] - s) <= abs(mk[mi & MKM] - s)) ( mi += 1; );
  a = mk[mi & MKM];
  la = mi > 0 ? a - mk[(mi - 1) & MKM] : TU;
  ra = mi + 1 < mcount ? mk[(mi + 1) & MKM] - a : la;
  la = clamp(la, 8, PMAX); ra = clamp(ra, 8, PMAX);
  fo = lookf(s, frOut); fi = lookf(s, frIn);
  (fo > 0 && fi > 0) ? (
    ts = srate / fo; ratio = fo / fi;
    fr = clamp(fmul * (keepform ? 1 : ratio), 0.25, 4);
  ) : (
    ts = ra + (a - s); ratio = 1; fr = 1;       // sin voz: vuelve a alinearse con la entrada
  );
  e = max(fr, 1);
  dens = (la + ra) * 0.5 / max(ts, 1);
  p_s = s; p_a = a; p_lo = la / e; p_ro = ra / e; p_fr = fr;
  p_g = clamp(sqrt(e / max(dens, 0.05)), 0.35, 2.5);
  p_ts = clamp(ts, 8, 4 * PMAX);
  p_spawn = s - p_lo;
  a + ra + 3 > nin - 1 ? late += 1;
  planned = 1;
);
// busca la marca siguiente cerca de c: el periodo que termina ahi debe parecerse al que termina en prev
// (correlacion normalizada, +-8 % del periodo, interpolacion parabolica). Asi las marcas siguen el
// periodo real aunque la deteccion venga ~25 ms atrasada (vibrato, deslizamientos).
function refine(prev, c, per) local(L, dr, d, j, ip, ic, s, ep, ec, xp, xc, v, best, bv, vm, vp, den, fr)
(
  L = floor(per); dr = max(floor(per * 0.08), 1);
  ip = floor(prev) - L;
  ep = 0; j = 0; loop(L, xp = inM[(ip + j) & RBM]; ep += xp * xp; j += 1; );
  best = 0; bv = -2; d = -dr;
  loop(2 * dr + 1,
    ic = floor(c) + d - L; s = 0; ec = 0; j = 0;
    loop(L, xp = inM[(ip + j) & RBM]; xc = inM[(ic + j) & RBM]; s += xp * xc; ec += xc * xc; j += 1; );
    v = s / sqrt(ep * ec + 0.000000000000000001);
    rcor[d + dr] = v;
    v > bv ? ( bv = v; best = d; );
    d += 1;
  );
  fr = 0;
  (best > -dr && best < dr) ? (
    vm = rcor[best + dr - 1]; vp = rcor[best + dr + 1]; den = vm - 2 * bv + vp;
    den < 0 ? fr = clamp(0.5 * (vm - vp) / den, -0.5, 0.5);
  );
  bv > 0.5 ? prev + (floor(c) - floor(prev)) + best + fr : c;
);
function activate() local(k, f)
(
  k = 0; f = -1;
  loop(NG, (f < 0 && !gOn[k]) ? f = k; k += 1; );
  f < 0 ? ( f = 0; late += 1000; );
  gS[f] = p_s; gA[f] = p_a; gLo[f] = p_lo; gRo[f] = p_ro; gFr[f] = p_fr; gG[f] = p_g; gOn[f] = 1;
);

// ---------------------------------------------------------------- tonalidad (perfiles de Krumhansl)
function load_profiles()
(
  kprof[0] = 6.35; kprof[1] = 2.23; kprof[2] = 3.48; kprof[3] = 2.33; kprof[4] = 4.38; kprof[5] = 4.09;
  kprof[6] = 2.52; kprof[7] = 5.19; kprof[8] = 2.39; kprof[9] = 3.66; kprof[10] = 2.29; kprof[11] = 2.88;
  kprof[12] = 6.33; kprof[13] = 2.68; kprof[14] = 3.52; kprof[15] = 5.38; kprof[16] = 2.60; kprof[17] = 3.53;
  kprof[18] = 2.54; kprof[19] = 4.75; kprof[20] = 3.98; kprof[21] = 2.69; kprof[22] = 3.34; kprof[23] = 3.17;
);
// deja la mejor tonalidad en key_best (0..11), key_minor (0/1) y key_conf (correlacion)
function guess_key() local(k, mn, i, sx, sy, sxx, syy, sxy, x, y, r, n, tot)
(
  key_conf = -2; tot = 0; i = 0; loop(12, tot += khist[i]; i += 1; );
  key_total = tot;
  tot > 0 ? (
    mn = 0;
    loop(2,
      k = 0;
      loop(12,
        sx = sy = sxx = syy = sxy = 0; i = 0;
        loop(12,
          x = khist[pcl(i + k)]; y = kprof[mn * 12 + i];
          sx += x; sy += y; sxx += x * x; syy += y * y; sxy += x * y; i += 1;
        );
        n = 12; r = (n * sxy - sx * sy) / sqrt(max((n * sxx - sx * sx) * (n * syy - sy * sy), 0.000000001));
        r > key_conf ? ( key_conf = r; key_best = k; key_minor = mn; );
        k += 1;
      );
      mn += 1;
    );
  );
);
function apply_learn()
(
  guess_key();
  key_total > 0 ? ( sset(12, key_best); sset(13, key_minor ? 2 : 1); );
);

// ---------------------------------------------------------------- presets
NPRESETS = 13;
function preset_name(n)
(
  n == 1 ? "Natural - correccion suave" :
  n == 2 ? "Pop moderno" :
  n == 3 ? "Hard tune - efecto robot" :
  n == 4 ? "Trap melodico" :
  n == 5 ? "Balada - respeta el vibrato" :
  n == 6 ? "Solo centrar notas largas" :
  n == 7 ? "Octava abajo" :
  n == 8 ? "Octava arriba" :
  n == 9 ? "Voz de monstruo" :
  n == 10 ? "Ardilla" :
  n == 11 ? "Vibrato agregado" :
  n == 12 ? "Doble afinado (mezcla 50%)" :
  n == 13 ? "Por defecto" : "";
);
// pr(velocidad, humanizar, flex, formantes, transponer, mezcla, formantes siguen el tono)
function pr(v, h, fl, fo, tr, mx, kf)
(
  sset(1, v); sset(2, h); sset(3, fl); sset(4, fo); sset(5, tr); sset(10, mx); sset(18, kf);
);
function load_preset(n)
(
  pr(20, 0, 0, 0, 0, 100, 0); sset(7, 0); sset(8, 5.5); sset(9, 300); sset(11, 0);
  n == 1 ? pr(50, 40, 30, 0, 0, 100, 0) :
  n == 2 ? pr(20, 20, 0, 0, 0, 100, 0) :
  n == 3 ? pr(0, 0, 0, 0, 0, 100, 0) :
  n == 4 ? pr(5, 10, 0, 0, 0, 100, 0) :
  n == 5 ? pr(90, 60, 40, 0, 0, 100, 0) :
  n == 6 ? pr(150, 70, 50, 0, 0, 100, 0) :
  n == 7 ? pr(20, 0, 0, 0, -12, 100, 0) :
  n == 8 ? pr(20, 0, 0, 0, 12, 100, 0) :
  n == 9 ? pr(20, 0, 0, -4, -10, 100, 0) :
  n == 10 ? pr(20, 0, 0, 0, 12, 100, 1) :
  n == 11 ? ( pr(10, 0, 0, 0, 0, 100, 0); sset(7, 40); sset(8, 5.5); sset(9, 250); ) :
  n == 12 ? pr(0, 0, 0, 0, 0, 50, 0);
  upd = 1;
);

// ---------------------------------------------------------------- arranque
memset(inL, 0, 2 * RB); memset(inM, 0, RB);
memset(khist, 0, 12); memset(held, 0, 128);
load_profiles();
nin = 0; late = 0; hw = 0;
memset(hIn, -1, NH); memset(hOut, -1, NH); memset(hTg, -1, NH);
held_mask = 0; midi_last = -1;
PMAX = 0;
update_params();
mix = mix_t; og = og_t;
last_learn = slider20;

@slider
slider21 > 0 ? ( s_pn = floor(slider21 + 0.5); slider21 = 0; slider_automate(slider21); load_preset(s_pn); );
update_params();
(last_learn && !slider20) ? ( apply_learn(); update_params(); );
(!last_learn && slider20) ? ( memset(khist, 0, 12); key_total = 0; );
last_learn = slider20;

@block
upd ? ( upd = 0; update_params(); );
// MIDI: notas tocadas (se dejan pasar)
while (midirecv(b_ofs, b_m1, b_m2, b_m3)) (
  b_st = b_m1 & $xF0;
  (b_st == $x90 && b_m3 > 0) ? ( held[b_m2] = 1; midi_last = b_m2; ) :
  (b_st == $x80 || (b_st == $x90 && b_m3 == 0)) ? (
    held[b_m2] = 0;
    b_m2 == midi_last ? ( midi_last = -1; b_i = 127; while (b_i >= 0 && midi_last < 0) ( held[b_i] ? midi_last = b_i; b_i -= 1; ); );
  ) : (b_st == $xB0 && (b_m2 == 123 || b_m2 == 120)) ? ( memset(held, 0, 128); midi_last = -1; );
  midisend(b_ofs, b_m1, b_m2, b_m3);
);
learn && (b_lc += samplesblock) > srate * 0.5 ? (
  b_lc = 0; guess_key();
  key_total > 0 && (slider12 != key_best || slider13 != (key_minor ? 2 : 1)) ? (
    slider12 = key_best; slider13 = key_minor ? 2 : 1; sliderchange(slider12); sliderchange(slider13);
  );
);
held_mask = 0; b_i = 0; loop(128, held[b_i] ? held_mask |= 1 << pcl(b_i); b_i += 1; );
late > slider22 ? ( slider22 = late; sliderchange(slider22); );

@sample
inL[nin & RBM] = spl0; inR[nin & RBM] = spl1; inM[nin & RBM] = (spl0 + spl1) * 0.5;
nin += 1;
(hopc += 1) >= HOP ? ( hopc = 0; detect(); );

// marcas de analisis: una por periodo, enganchadas al periodo real por correlacion; sin voz, cada 5 ms
while (am + amT * 1.1 + 2 <= nin - 1) (
  a_c = am + amT;
  am_v ? a_c = refine(am, a_c, amT);
  am = a_c; mk[mcount & MKM] = am; mcount += 1;
  a_f = lookf(am, frIn); am_v = a_f > 0; amT = a_f > 0 ? srate / a_f : TU;
);

// sintesis: los granos se planean y se activan a tiempo
a_t = nin - 1 - LAT;
a_go = 1;
while (a_go) (
  !planned ? ( a_t >= s_next - PMAX - 1 ? plan() : ( a_go = 0; ); );
  a_go ? ( a_t >= p_spawn ? ( activate(); s_next = p_s + p_ts; planned = 0; ) : ( a_go = 0; ); );
);
a_wl = a_wr = 0;
a_k = 0;
loop(NG,
  gOn[a_k] ? (
    a_o = a_t - gS[a_k];
    a_o >= gRo[a_k] ? ( gOn[a_k] = 0; ) : ( a_o > -gLo[a_k] ? (
      a_w = gG[a_k] * (0.5 + 0.5 * cos($pi * a_o / (a_o < 0 ? gLo[a_k] : gRo[a_k])));
      a_u = gA[a_k] + a_o * gFr[a_k];
      a_wl += a_w * herm(inL, a_u); a_wr += a_w * herm(inR, a_u);
    ); );
  );
  a_k += 1;
);
mix += (mix_t - mix) * 0.0015; og += (og_t - og) * 0.0015;
a_dl = inL[a_t & RBM]; a_dr = inR[a_t & RBM];
spl0 = (a_dl + (a_wl - a_dl) * mix) * og;
spl1 = (a_dr + (a_wr - a_dr) * mix) * og;

a_x = max(abs(a_dl), abs(a_dr)); a_x > m_in ? m_in = a_x;
a_x = max(abs(spl0), abs(spl1)); a_x > m_out ? m_out = a_x;

@gfx 1000 640
// ======================================================================= interfaz
SC = gfx_ext_retina > 1 ? gfx_ext_retina : 1;
WW = gfx_w; WH = gfx_h;

function fnt(i) (
  i == 1 ? gfx_setfont(1, "Helvetica Neue", 13 * SC) :
  i == 2 ? gfx_setfont(2, "Helvetica Neue", 11 * SC) :
  i == 3 ? gfx_setfont(3, "Helvetica Neue", 17 * SC, 'b') :
  i == 4 ? gfx_setfont(4, "Helvetica Neue", 10 * SC, 'b') :
  i == 6 ? gfx_setfont(6, "Helvetica Neue", 15 * SC, 'b') :
  i == 7 ? gfx_setfont(7, "Helvetica Neue", 46 * SC, 'b') :
  i == 8 ? gfx_setfont(8, "Helvetica Neue", 9 * SC) :
           gfx_setfont(5, "Helvetica Neue", 12 * SC, 'b');
);
function acc(a) ( gfx_set(0.72, 0.58, 1.00, a); );      // violeta: lo que sale (afinado)
function inc(a) ( gfx_set(1.00, 0.70, 0.36, a); );      // ambar: lo que entra
function panel_bg() ( gfx_set(0.095, 0.105, 0.135, 1); );

function pc_name(c)
(
  c == 0 ? "C" : c == 1 ? "C#" : c == 2 ? "D" : c == 3 ? "D#" : c == 4 ? "E" : c == 5 ? "F" :
  c == 6 ? "F#" : c == 7 ? "G" : c == 8 ? "G#" : c == 9 ? "A" : c == 10 ? "A#" : "B";
);
function note_str(d, n) ( sprintf(d, "%s%d", pc_name(pcl(n)), floor(n / 12) - 1); );
function scale_name(s)
(
  s == 0 ? "Cromatica" : s == 1 ? "Mayor" : s == 2 ? "Menor" : s == 3 ? "Menor armonica" : s == 4 ? "Menor melodica" :
  s == 5 ? "Pentatonica mayor" : s == 6 ? "Pentatonica menor" : s == 7 ? "Blues" : s == 8 ? "Dorica" :
  s == 9 ? "Frigia" : s == 10 ? "Lidia" : s == 11 ? "Mixolidia" : "Personalizada";
);
function voice_name(v) ( v == 0 ? "Soprano / Alto" : v == 1 ? "Tenor / media" : v == 2 ? "Baritono / Bajo" : "Instrumento grave"; );
function midi_name(m) ( m == 0 ? "Apagado" : m == 1 ? "Notas = escala" : "Nota exacta"; );

function hit_add(x, y, w, h, id) local(p)
( hit_n < 300 ? ( p = hitmem + hit_n * 5; p[0] = x; p[1] = y; p[2] = w; p[3] = h; p[4] = id; hit_n += 1; ); );
function hit_find(mx, my) local(i, p, r)
(
  r = 0; i = hit_n - 1;
  while (i >= 0 && r == 0) (
    p = hitmem + i * 5;
    (mx >= p[0] && mx < p[0] + p[2] && my >= p[1] && my < p[1] + p[3]) ? r = p[4];
    i -= 1;
  );
  r;
);

function frect(x, y, w, h, r) (
  r = min(r, min(w, h) * 0.5);
  gfx_rect(x + r, y, w - 2 * r, h, 1);
  gfx_rect(x, y + r, r, h - 2 * r, 1);
  gfx_rect(x + w - r, y + r, r, h - 2 * r, 1);
  gfx_circle(x + r, y + r, r, 1, 1); gfx_circle(x + w - r - 1, y + r, r, 1, 1);
  gfx_circle(x + r, y + h - r - 1, r, 1, 1); gfx_circle(x + w - r - 1, y + h - r - 1, r, 1, 1);
);
function text_c(str, x, y, w, h) ( gfx_x = x; gfx_y = y; gfx_drawstr(str, 1 | 4, x + w, y + h); );
function text_l(str, x, y, h) ( gfx_x = x; gfx_y = y; gfx_drawstr(str, 4, x + 2000, y + h); );
function text_r(str, x, y, w, h) ( gfx_x = x; gfx_y = y; gfx_drawstr(str, 2 | 4, x + w, y + h); );
function section(str, x, y, w) local(tw, th)
(
  fnt(4); gfx_set(0.50, 0.53, 0.62, 1); text_l(str, x, y, 14 * SC);
  gfx_measurestr(str, tw, th);
  gfx_set(1, 1, 1, 0.07); gfx_line(x + tw + 8 * SC, y + 7 * SC, x + w, y + 7 * SC);
);

function button(id, x, y, w, h, str, on)
(
  hov = hover_id == id;
  on ? acc(1) : gfx_set(hov ? 0.24 : 0.17, hov ? 0.26 : 0.19, hov ? 0.31 : 0.24, 1);
  frect(x, y, w, h, 5 * SC);
  on ? gfx_set(0.08, 0.06, 0.12, 1) : gfx_set(0.86, 0.88, 0.92, 1);
  fnt(5); text_c(str, x, y, w, h);
  hit_add(x, y, w, h, id);
);

function dropdown(id, x, y, w, h, label, str)
(
  hov = hover_id == id;
  gfx_set(hov ? 0.24 : 0.17, hov ? 0.26 : 0.19, hov ? 0.31 : 0.24, 1);
  frect(x, y, w, h, 5 * SC);
  fnt(2); gfx_set(0.55, 0.58, 0.65, 1);
  text_l(label, x + 8 * SC, y, h);
  strlen(label) ? gfx_measurestr(label, _tw, _th) : _tw = -4 * SC;
  fnt(1); gfx_set(0.90, 0.92, 0.96, 1);
  text_l(str, x + 12 * SC + _tw, y, h);
  gfx_set(0.55, 0.58, 0.65, 1);
  _cx = x + w - 12 * SC; _cy = y + h * 0.5;
  gfx_triangle(_cx - 4 * SC, _cy - 2 * SC, _cx + 4 * SC, _cy - 2 * SC, _cx, _cy + 3 * SC);
  hit_add(x, y, w, h, id);
);

function knob(id, cx, cy, r, label, str, n, bip, enabled) local(a0, a1, av, i, rr)
(
  a0 = -0.75 * $pi; a1 = 0.75 * $pi; av = a0 + (a1 - a0) * clamp(n, 0, 1);
  fnt(2); gfx_set(0.62, 0.65, 0.72, enabled ? 1 : 0.4);
  text_c(label, cx - 50 * SC, cy - r - 18 * SC, 100 * SC, 14 * SC);
  gfx_set(0.13, 0.14, 0.18, 1); gfx_circle(cx, cy, r, 1, 1);
  gfx_set(0.17, 0.18, 0.23, 1); gfx_circle(cx, cy, r * 0.62, 1, 1);
  gfx_set(0.26, 0.28, 0.34, 1);
  i = 0; loop(3 * SC, gfx_arc(cx, cy, r - 2 * SC - i, a0, a1, 1); i += 1; );
  acc(enabled ? 1 : 0.35);
  i = 0; loop(3 * SC, rr = r - 2 * SC - i;
    bip ? ( av < 0 ? gfx_arc(cx, cy, rr, av, 0, 1) : gfx_arc(cx, cy, rr, 0, av, 1); )
        : gfx_arc(cx, cy, rr, a0, av, 1);
    i += 1; );
  gfx_set(0.92, 0.93, 0.96, enabled ? 1 : 0.4);
  gfx_line(cx + sin(av) * r * 0.25, cy - cos(av) * r * 0.25, cx + sin(av) * (r - 6 * SC), cy - cos(av) * (r - 6 * SC), 1);
  hover_id == id ? ( gfx_set(1, 1, 1, 0.12); gfx_circle(cx, cy, r + 2 * SC, 0, 1); );
  fnt(1); gfx_set(0.92, 0.93, 0.96, enabled ? 1 : 0.45);
  text_c(str, cx - 50 * SC, cy + r + 3 * SC, 100 * SC, 16 * SC);
  hit_add(cx - r - 8 * SC, cy - r - 4 * SC, 2 * r + 16 * SC, 2 * r + 24 * SC, id);
);

// ---------------------------------------------------------- controles: id -> slider, minimo, maximo, curva, defecto, paso
// curva: 0 = lineal, 2 = cuadratica (mas resolucion abajo)
function ctl_info(id)
(
  id == 1 ? ( ci_s = 1; ci_a = 0; ci_b = 400; ci_l = 2; ci_d = 20; ci_p = 1; ) :
  id == 2 ? ( ci_s = 2; ci_a = 0; ci_b = 100; ci_l = 0; ci_d = 0; ci_p = 1; ) :
  id == 3 ? ( ci_s = 3; ci_a = 0; ci_b = 100; ci_l = 0; ci_d = 0; ci_p = 1; ) :
  id == 4 ? ( ci_s = 4; ci_a = -12; ci_b = 12; ci_l = 0; ci_d = 0; ci_p = 0.1; ) :
  id == 5 ? ( ci_s = 5; ci_a = -24; ci_b = 24; ci_l = 0; ci_d = 0; ci_p = 1; ) :
  id == 6 ? ( ci_s = 6; ci_a = 415; ci_b = 465; ci_l = 0; ci_d = 440; ci_p = 0.1; ) :
  id == 7 ? ( ci_s = 7; ci_a = 0; ci_b = 100; ci_l = 0; ci_d = 0; ci_p = 1; ) :
  id == 8 ? ( ci_s = 8; ci_a = 1; ci_b = 10; ci_l = 0; ci_d = 5.5; ci_p = 0.1; ) :
  id == 9 ? ( ci_s = 9; ci_a = 0; ci_b = 1500; ci_l = 0; ci_d = 300; ci_p = 10; ) :
  id == 10 ? ( ci_s = 10; ci_a = 0; ci_b = 100; ci_l = 0; ci_d = 100; ci_p = 1; ) :
  id == 11 ? ( ci_s = 11; ci_a = -12; ci_b = 12; ci_l = 0; ci_d = 0; ci_p = 0.1; ) :
  id == 12 ? ( ci_s = 16; ci_a = 0; ci_b = 100; ci_l = 0; ci_d = 50; ci_p = 1; ) :
  id == 13 ? ( ci_s = 17; ci_a = -80; ci_b = -20; ci_l = 0; ci_d = -50; ci_p = 1; ) :
  ci_s = 0;
);
function ctl_get(id) local(n)
( ctl_info(id); n = nlin(slider(ci_s), ci_a, ci_b); ci_l == 2 ? sqrt(clamp(n, 0, 1)) : n; );
function ctl_setv(id, v)
(
  ctl_info(id);
  v = clamp(floor(v / ci_p + 0.5) * ci_p, ci_a, ci_b);
  sset(ci_s, v); upd = 1;
);
function ctl_set(id, n) ( ctl_info(id); n = clamp(n, 0, 1); ctl_setv(id, dlin(ci_l == 2 ? n * n : n, ci_a, ci_b)); );
function ctl_default(id) ( ctl_info(id); ctl_setv(id, ci_d); );

// escala: alternar una nota (pasa a Personalizada)
function toggle_pc(c) local(m)
(
  m = eff_mask();
  m = (m >> c) & 1 ? m - (1 << c) : m + (1 << c);
  sset(14, m); sset(13, 12); upd = 1;
);

// ---------------------------------------------------------- ayudas
function hint_for(id)
(
  id == 1 ? strcpy(#hint, "Velocidad: que tan rapido llega a la nota. 0 ms = efecto robot (T-Pain). 10-30 ms = pop moderno. 50-100 ms = natural.") :
  id == 2 ? strcpy(#hint, "Humanizar: en las notas largas corrige mas lento (deja el vibrato y la expresion) sin dejar de afinar los cambios rapidos.") :
  id == 3 ? strcpy(#hint, "Flex: solo corrige cuando ya cantas cerca de la nota; los deslizamientos y adornos lejos de ella pasan tal cual.") :
  id == 4 ? strcpy(#hint, "Formantes: el timbre (tamano de la garganta) sin cambiar la nota. Negativo = mas grave / grueso, positivo = mas fino.") :
  id == 5 ? strcpy(#hint, "Transponer: mueve la voz ya afinada en semitonos. +12 / -12 = una octava. Los formantes se preservan (no suena a ardilla).") :
  id == 6 ? strcpy(#hint, "La de referencia: afinacion del La (A4). 440 Hz es lo normal; cambialo si la cancion esta afinada distinto (432, 442...).") :
  id == 7 ? strcpy(#hint, "Vibrato: agrega vibrato a la voz afinada. Profundidad en cents (30-50 = notorio).") :
  id == 8 ? strcpy(#hint, "Vibrato velocidad: ciclos por segundo. Las voces reales van de 5 a 6.5 Hz.") :
  id == 9 ? strcpy(#hint, "Vibrato retardo: cuanto espera desde que empieza la nota antes de vibrar (como lo haria un cantante).") :
  id == 10 ? strcpy(#hint, "Mezcla: 100% = solo la voz afinada. 50% = afinada + original (doble / coro). 0% = sin efecto.") :
  id == 11 ? strcpy(#hint, "Salida: volumen final.") :
  id == 12 ? strcpy(#hint, "Sensibilidad: mas alto = considera voz tambien lo ronco o susurrado; mas bajo = solo notas claras (menos errores).") :
  id == 13 ? strcpy(#hint, "Puerta: lo que esta bajo este nivel no se analiza (ruido de fondo, respiraciones, sangrado de audifonos).") :
  (id >= 20 && id <= 31) ? (
    strcpy(#hint, "Nota "); strcat(#hint, pc_name(id - 20));
    strcat(#hint, bit(emask, id - 20) ? ": activa (la voz puede ir a ella). Clic = quitarla." : ": quitada (la voz salta a la vecina). Clic = activarla.");
  ) :
  id == 40 ? strcpy(#hint, "Preservar formantes: al transponer, la voz mantiene su timbre. Apagado = los formantes siguen el tono (efecto ardilla / monstruo).") :
  id == 41 ? strcpy(#hint, "Aprender tono: reproduce la cancion (o la voz) unos segundos con esto encendido; al apagarlo pone la tonalidad y la escala.") :
  id == 50 ? strcpy(#hint, "Presets: el caracter de la correccion (no cambian la tonalidad). Para guardar los tuyos usa el + de REAPER.") :
  id == 51 ? strcpy(#hint, "Tonalidad: la tonica de la cancion. Si no la sabes, usa Aprender tono.") :
  id == 52 ? strcpy(#hint, "Escala: las notas permitidas. Cromatica = las 12 (corrige a la mas cercana). Tambien puedes elegir notas en el teclado.") :
  id == 53 ? strcpy(#hint, "Rango de voz: la nota mas grave que se busca. Mas agudo = menos latencia y menos errores de octava.") :
  id == 54 ? strcpy(#hint, "MIDI: Notas = escala -> las teclas que mantienes son las notas permitidas. Nota exacta -> la voz va a la nota MIDI tocada.") :
  id == 100 ? strcpy(#hint, "Grafica: ambar = la voz que entra, violeta = la que sale afinada. Rueda = zoom | arrastra = mover | doble clic = seguir la voz") :
  id == 101 ? strcpy(#hint, "Notas: clic en un nombre = activar / quitar esa nota de la escala.") :
  id == 102 ? strcpy(#hint, "Nota actual: a que nota va la voz. Medidor: ambar = cuanto desafinada entra; violeta = cuanto corrige.") :
  strcpy(#hint, "Nube Tune: elige la tonalidad y la escala, y ajusta la Velocidad. Pasa el mouse sobre cualquier cosa para ver que hace.");
);

// ---------------------------------------------------------- menus
function menu_presets() local(r, i)
(
  #m = "#PRESETS DE NUBE TUNE";
  i = 1; loop(NPRESETS, strcat(#m, "|"); strcat(#m, preset_name(i)); i += 1; );
  gfx_x = mouse_x; gfx_y = mouse_y;
  r = gfx_showmenu(#m);
  r >= 2 ? load_preset(r - 1);
);
function menu_key() local(r, i)
(
  #m = ""; i = 0;
  loop(12, i ? strcat(#m, "|"); slider12 == i ? strcat(#m, "!"); strcat(#m, pc_name(i)); i += 1; );
  gfx_x = mouse_x; gfx_y = mouse_y;
  r = gfx_showmenu(#m);
  r > 0 ? ( sset(12, r - 1); upd = 1; );
);
function menu_scale() local(r, i, m)
(
  #m = ""; i = 0;
  loop(NSCALES, i ? strcat(#m, "|"); slider13 == i ? strcat(#m, "!"); strcat(#m, scale_name(i)); i += 1; );
  gfx_x = mouse_x; gfx_y = mouse_y;
  r = gfx_showmenu(#m);
  r > 0 ? (
    m = eff_mask();
    r - 1 == 12 ? sset(14, m);
    sset(13, r - 1); upd = 1;
  );
);
function menu_list(sl, n, a, b, c, d) local(r, i)
(
  #m = ""; i = 0;
  loop(n, i ? strcat(#m, "|"); slider(sl) == i ? strcat(#m, "!"); strcat(#m, i == 0 ? a : i == 1 ? b : i == 2 ? c : d); i += 1; );
  gfx_x = mouse_x; gfx_y = mouse_y;
  r = gfx_showmenu(#m);
  r > 0 ? ( sset(sl, r - 1); upd = 1; );
);

// ======================================================================= layout
TOPH = 44 * SC; PANH = 178 * SC; FOOTH = 26 * SC;
dy = TOPH + 10 * SC;
dh = WH - TOPH - PANH - FOOTH - 20 * SC; dh < 170 * SC ? dh = 170 * SC;
RW = 236 * SC; rx0 = WW - 14 * SC - RW;
lx0 = 14 * SC; LW = 40 * SC;
gx0 = lx0 + LW; gw = rx0 - 12 * SC - gx0;
py = dy + dh + 10 * SC;
vrange == 0 ? ( vrange = 14; vcen = 57; follow = 1; );
function n2y(n) ( dy + dh * 0.5 - (n - vcen) / vrange * dh );
function y2n(y) ( vcen - (y - dy - dh * 0.5) / dh * vrange );
fps = srate / HOP;

// ======================================================================= mouse
mx = mouse_x; my = mouse_y;
lb = mouse_cap & 1; rbtn = mouse_cap & 2; shift = mouse_cap & 8;
hover_id = drag ? drag_id : hit_find(mx, my);

lb && !last_lb ? (
  _now = time_precise();
  dbl = _now - last_t < 0.35 && abs(mx - last_x) < 6 * SC && abs(my - last_y) < 6 * SC;
  last_t = dbl ? 0 : _now; last_x = mx; last_y = my;
  (hover_id >= 1 && hover_id <= 13) ? (
    dbl ? ctl_default(hover_id) : ( drag = 1; drag_id = hover_id; drag_my = my; drag_n = ctl_get(hover_id); );
  ) : hover_id == 100 ? (
    dbl ? ( follow = 1; ) : ( drag = 1; drag_id = 100; drag_my = my; drag_v = vcen; );
  ) : hover_id == 101 ? toggle_pc(pcl(floor(y2n(my) + 0.5)))
    : (hover_id >= 20 && hover_id <= 31) ? toggle_pc(hover_id - 20)
    : hover_id == 40 ? ( sset(18, slider18 ? 0 : 1); upd = 1; )
    : hover_id == 41 ? ( slider20 ? ( sset(20, 0); apply_learn(); last_learn = 0; ) : ( sset(20, 1); memset(khist, 0, 12); last_learn = 1; ); upd = 1; )
    : hover_id == 50 ? menu_presets()
    : hover_id == 51 ? menu_key()
    : hover_id == 52 ? menu_scale()
    : hover_id == 53 ? menu_list(15, 4, "Soprano / Alto (desde 120 Hz)", "Tenor / voz media (desde 85 Hz)", "Baritono / Bajo (desde 65 Hz)", "Instrumento grave (desde 40 Hz)")
    : hover_id == 54 ? menu_list(19, 3, "Apagado", "Notas tocadas = escala", "Nota exacta (la voz va a la nota MIDI)", "");
);

lb && drag ? (
  _k = shift ? 0.1 : 1;
  (drag_id >= 1 && drag_id <= 13) ? ctl_set(drag_id, drag_n + (drag_my - my) / (220 * SC) * _k) :
  drag_id == 100 ? ( follow = 0; vcen = clamp(drag_v + (my - drag_my) / dh * vrange, 20, 110); );
);
!lb ? drag = 0;

rbtn && !last_rb ? ( (hover_id == 100 || hover_id == 102) ? menu_presets(); );

mouse_wheel != 0 ? (
  _w = mouse_wheel / 120;
  (hover_id >= 1 && hover_id <= 13) ? ctl_set(hover_id, ctl_get(hover_id) + _w * (shift ? 0.002 : 0.012)) :
  (hover_id == 100 || hover_id == 101) ? vrange = clamp(vrange * (_w > 0 ? 0.85 : 1 / 0.85), 5, 48);
  mouse_wheel = 0;
);
last_lb = lb; last_rb = rbtn;

// ======================================================================= dibujo
hit_n = 0;
gfx_set(0.075, 0.082, 0.105, 1); gfx_rect(0, 0, WW, WH, 1);

// ---- barra superior
gfx_gradrect(0, 0, WW, TOPH, 0.115, 0.125, 0.16, 1, 0, 0, 0, 0, -0.0006 / SC, -0.0006 / SC, -0.0006 / SC, 0);
fnt(3); gfx_set(0.62, 0.80, 1.0, 1); text_l("NUBE", 14 * SC, 0, TOPH);
gfx_measurestr("NUBE ", _tw, _th);
gfx_set(0.93, 0.94, 0.97, 1); text_l("TUNE", 14 * SC + _tw, 0, TOPH);
_x = 150 * SC; _y = 9 * SC; _h = 26 * SC;
dropdown(50, _x, _y, 116 * SC, _h, "", "Presets"); _x += 124 * SC;
dropdown(51, _x, _y, 96 * SC, _h, "Tono", pc_name(slider12)); _x += 104 * SC;
dropdown(52, _x, _y, 196 * SC, _h, "Escala", scale_name(slider13)); _x += 204 * SC;
dropdown(53, _x, _y, 182 * SC, _h, "Voz", voice_name(slider15)); _x += 190 * SC;
_x + 150 * SC < WW ? dropdown(54, _x, _y, min(160 * SC, WW - _x - 14 * SC), _h, "MIDI", midi_name(slider19));

// ---- grafica de tono (rollo de piano)
panel_bg(); gfx_rect(lx0, dy, LW + gw, dh, 1);
follow ? (
  // centrar en la voz reciente
  _n = 0; _sum = 0; _i = 1;
  loop(min(NH - 1, floor(fps * 3)), _j = (hw - _i) & NHM; hIn[_j] > 0 ? ( _sum += hIn[_j]; _n += 1; ); _i += 1; );
  _n > 10 ? vcen += (_sum / _n - vcen) * 0.06;
);
_nlo = floor(y2n(dy + dh)) - 1; _nhi = ceil(y2n(dy)) + 1;
_lh = dh / vrange;
_n = _nlo;
loop(_nhi - _nlo + 1,
  _y0 = n2y(_n + 0.5); _y1 = n2y(_n - 0.5);
  _ya = max(_y0, dy); _yb = min(_y1, dy + dh);
  _yb > _ya ? (
    _c = pcl(_n); _ok = bit(emask, _c); _blk = _c == 1 || _c == 3 || _c == 6 || _c == 8 || _c == 10;
    _ok ? ( gfx_set(1, 1, 1, 0.035); gfx_rect(gx0, _ya, gw, _yb - _ya, 1); );
    (_n == cur_t && hTg[(hw - 1) & NHM] >= 0) ? ( acc(0.10); gfx_rect(gx0, _ya, gw, _yb - _ya, 1); );
    gfx_set(1, 1, 1, _c == 0 ? 0.10 : 0.035); gfx_line(gx0, _y1, gx0 + gw - 1, _y1);
    // tira de nombres (como teclas de piano)
    _blk ? gfx_set(0.11, 0.12, 0.15, 1) : gfx_set(0.16, 0.17, 0.21, 1);
    gfx_rect(lx0, _ya, LW - 2 * SC, _yb - _ya, 1);
    _ok ? ( gfx_set(0.63, 0.51, 0.88, 1); gfx_rect(lx0 + LW - 5 * SC, _ya + 1, 3 * SC, max(_yb - _ya - 2, 1), 1); );
    (_lh >= 11 * SC || _c == 0) && _y0 >= dy && _y1 <= dy + dh ? (
      fnt(8); _ok ? gfx_set(0.88, 0.90, 0.95, 1) : gfx_set(0.42, 0.45, 0.52, 1);
      note_str(#s, _n); text_l(#s, lx0 + 4 * SC, _y0, _y1 - _y0);
    );
  );
  _n += 1;
);
hit_add(lx0, dy, LW, dh, 101);
// segundos
_ncol = floor(gw / SC); _span = 6;
_spc = _span * fps / _ncol;
_s = 1; loop(_span - 1, _xx = gx0 + gw - _s * fps / _spc * SC; gfx_set(1, 1, 1, 0.04); gfx_line(_xx, dy, _xx, dy + dh - 1); _s += 1; );
// lineas: entrada y salida
function draw_track(arr, thick) local(c, j, v, xx, yy, pv, px, py_)
(
  c = 0; pv = -1;
  loop(_ncol,
    j = (hw - 1 - floor((_ncol - 1 - c) * _spc)) & NHM;
    v = arr[j];
    xx = gx0 + c * SC; yy = n2y(v);
    (v > 0 && pv > 0 && abs(v - pv) < 3) ? (
      (yy > dy && yy < dy + dh && py_ > dy && py_ < dy + dh) ? (
        gfx_line(px, py_, xx, yy, 1);
        thick ? gfx_line(px, py_ + 1, xx, yy + 1, 1);
      );
    );
    pv = v; px = xx; py_ = yy;
    c += 1;
  );
);
acc(1); draw_track(hOut, 1);
inc(0.9); draw_track(hIn, 0);
// leyenda
fnt(4); _xx = gx0 + 10 * SC;
inc(1); text_l("ENTRADA", _xx, dy + 6 * SC, 14 * SC); gfx_measurestr("ENTRADA", _tw, _th); _xx += _tw + 14 * SC;
acc(1); text_l("SALIDA AFINADA", _xx, dy + 6 * SC, 14 * SC);
!follow ? ( gfx_set(0.62, 0.65, 0.72, 1); text_r("doble clic = seguir la voz", gx0, dy + 6 * SC, gw - 10 * SC, 14 * SC); );
(hover_id == 100 || (drag && drag_id == 100)) ? ( gfx_set(1, 1, 1, 0.18); gfx_rect(gx0, dy, gw, dh, 0); );
hit_add(gx0, dy, gw, dh, 100);

// ---- panel derecho: nota, medidor y secciones
panel_bg(); gfx_rect(rx0, dy, RW, dh, 1);
_lastv = hTg[(hw - 1) & NHM] >= 0;
_lastv ? ( d_note = hTg[(hw - 1) & NHM]; d_age = 0; ) : ( d_age += 1; );
_live = d_age < 20 && d_note > 0;
_lastv ? (
  d_cents += ((hIn[(hw - 1) & NHM] - d_note) * 100 - d_cents) * 0.35;
  d_corr += ((hOut[(hw - 1) & NHM] - hIn[(hw - 1) & NHM] - transp) * 100 - d_corr) * 0.35;
) : ( d_cents *= 0.9; d_corr *= 0.9; );
section("NOTA", rx0 + 12 * SC, dy + 8 * SC, RW - 24 * SC);
fnt(7);
_live ? ( acc(1); note_str(#s, d_note); ) : ( gfx_set(0.35, 0.37, 0.44, 1); strcpy(#s, "--"); );
text_c(#s, rx0, dy + 22 * SC, RW, 52 * SC);
fnt(2); gfx_set(0.62, 0.65, 0.72, 1);
_live ? sprintf(#s, "entra %+d ct   corrige %+d ct", floor(d_cents + 0.5), floor(d_corr + 0.5)) : strcpy(#s, "sin voz");
text_c(#s, rx0, dy + 74 * SC, RW, 14 * SC);
// medidor de cents (-50 .. +50)
_mx = rx0 + 16 * SC; _mw = RW - 32 * SC; _my = dy + 96 * SC; _mh = 16 * SC;
gfx_set(0.13, 0.14, 0.18, 1); frect(_mx, _my, _mw, _mh, 4 * SC);
_c0 = _mx + _mw * 0.5;
_i = -50; loop(11, _xx = _c0 + _i / 50 * _mw * 0.5; gfx_set(1, 1, 1, _i == 0 ? 0.35 : 0.10); gfx_line(_xx, _my + 2 * SC, _xx, _my + _mh - 2 * SC); _i += 10; );
_live ? (
  acc(0.85); _v = clamp(d_corr / 50, -1, 1) * _mw * 0.5;
  _v < 0 ? gfx_rect(_c0 + _v, _my + _mh * 0.5 - 2 * SC, -_v, 4 * SC, 1) : gfx_rect(_c0, _my + _mh * 0.5 - 2 * SC, _v, 4 * SC, 1);
  inc(1); _xx = _c0 + clamp(d_cents / 50, -1, 1) * _mw * 0.5;
  gfx_rect(_xx - SC, _my - 2 * SC, 2 * SC, _mh + 4 * SC, 1);
);
fnt(8); gfx_set(0.50, 0.53, 0.60, 1);
text_l("-50", _mx, _my + _mh + 2 * SC, 12 * SC); text_r("+50", _mx, _my + _mh + 2 * SC, _mw, 12 * SC);
text_c("cents", _mx, _my + _mh + 2 * SC, _mw, 12 * SC);
// medidores de nivel
pk_in = max(m_in, pk_in * 0.92); pk_out = max(m_out, pk_out * 0.92); m_in = m_out = 0;
_k = 0;
loop(2,
  _yy = dy + 136 * SC + _k * 12 * SC;
  fnt(8); gfx_set(0.50, 0.53, 0.60, 1); text_l(_k ? "OUT" : "IN", _mx, _yy - 2 * SC, 10 * SC);
  _bx = _mx + 26 * SC; _bw = _mw - 26 * SC;
  gfx_set(0.13, 0.14, 0.18, 1); gfx_rect(_bx, _yy, _bw, 6 * SC, 1);
  _db = 20 * log10((_k ? pk_out : pk_in) + 0.000000001); _lv = clamp((_db + 60) / 60, 0, 1);
  _db > -0.5 ? gfx_set(1, 0.35, 0.3, 1) : _db > -6 ? gfx_set(0.95, 0.85, 0.35, 1) : gfx_set(0.42, 0.85, 0.55, 1);
  gfx_rect(_bx, _yy, _bw * _lv, 6 * SC, 1);
  _k += 1;
);
hit_add(rx0, dy, RW, 160 * SC, 102);
// vibrato
_sy = dy + 166 * SC;
_sy + 150 * SC < dy + dh ? (
  section("VIBRATO", rx0 + 12 * SC, _sy, RW - 24 * SC);
  _ky = _sy + 50 * SC; _kr = 16 * SC; _kx = rx0 + 42 * SC; _ks = 76 * SC;
  sprintf(#s, "%d ct", slider7); knob(7, _kx, _ky, _kr, "Profundidad", slider7 > 0 ? #s : "Apagado", ctl_get(7), 0, 1); _kx += _ks;
  sprintf(#s, "%.1f Hz", slider8); knob(8, _kx, _ky, _kr, "Velocidad", #s, ctl_get(8), 0, slider7 > 0); _kx += _ks;
  sprintf(#s, "%d ms", slider9); knob(9, _kx, _ky, _kr, "Retardo", #s, ctl_get(9), 0, slider7 > 0);
  _sy += 92 * SC;
  section("DETECCION", rx0 + 12 * SC, _sy, RW - 24 * SC);
  _ky = _sy + 50 * SC; _kx = rx0 + 42 * SC;
  sprintf(#s, "%d %%", slider16); knob(12, _kx, _ky, _kr, "Sensibilidad", #s, ctl_get(12), 0, 1); _kx += _ks;
  sprintf(#s, "%d dB", slider17); knob(13, _kx, _ky, _kr, "Puerta", #s, ctl_get(13), 0, 1); _kx += _ks;
  sprintf(#s, "%.1f Hz", slider6); knob(6, _kx, _ky, _kr, "La (A4)", #s, ctl_get(6), 1, 1);
);

// ---- panel inferior
gfx_set(0.10, 0.11, 0.14, 1); gfx_rect(0, py - 4 * SC, WW, WH - py + 4 * SC, 1);
// teclado de la escala
section("NOTAS DE LA ESCALA", 14 * SC, py + 6 * SC, 296 * SC);
_kx0 = 14 * SC; _ky0 = py + 28 * SC; _kw = 42 * SC; _kh = 88 * SC;
_tc = hTg[(hw - 1) & NHM]; _tc = _tc >= 0 ? pcl(_tc) : -1;
// blancas
_i = 0;
loop(7,
  _c = _i == 0 ? 0 : _i == 1 ? 2 : _i == 2 ? 4 : _i == 3 ? 5 : _i == 4 ? 7 : _i == 5 ? 9 : 11;
  _xx = _kx0 + _i * _kw; _on = bit(emask, _c); _hv = hover_id == 20 + _c;
  _on ? gfx_set(_hv ? 0.95 : 0.88, _hv ? 0.95 : 0.89, _hv ? 0.99 : 0.93, 1) : gfx_set(_hv ? 0.36 : 0.28, _hv ? 0.37 : 0.29, _hv ? 0.42 : 0.33, 1);
  frect(_xx + SC, _ky0, _kw - 2 * SC, _kh, 4 * SC);
  _c == _tc ? ( acc(1); frect(_xx + 4 * SC, _ky0 + _kh - 12 * SC, _kw - 8 * SC, 7 * SC, 3 * SC); );
  fnt(5); _on ? gfx_set(0.12, 0.10, 0.18, 1) : gfx_set(0.55, 0.57, 0.63, 1);
  text_c(pc_name(_c), _xx, _ky0 + _kh - 34 * SC, _kw, 16 * SC);
  hit_add(_xx, _ky0, _kw, _kh, 20 + _c);
  _i += 1;
);
// negras
_i = 0;
loop(5,
  _c = _i == 0 ? 1 : _i == 1 ? 3 : _i == 2 ? 6 : _i == 3 ? 8 : 10;
  _pos = _i == 0 ? 1 : _i == 1 ? 2 : _i == 2 ? 4 : _i == 3 ? 5 : 6;
  _xx = _kx0 + _pos * _kw - 13 * SC; _on = bit(emask, _c); _hv = hover_id == 20 + _c;
  gfx_set(0.075, 0.082, 0.105, 1); frect(_xx - SC, _ky0 - SC, 28 * SC, 54 * SC, 4 * SC);
  _on ? (_hv ? acc(1) : gfx_set(0.63, 0.51, 0.88, 1)) : gfx_set(_hv ? 0.24 : 0.17, _hv ? 0.25 : 0.18, _hv ? 0.30 : 0.22, 1);
  frect(_xx, _ky0, 26 * SC, 52 * SC, 4 * SC);
  _c == _tc ? ( gfx_set(1, 1, 1, 0.9); frect(_xx + 5 * SC, _ky0 + 42 * SC, 16 * SC, 5 * SC, 2 * SC); );
  fnt(4); _on ? gfx_set(0.10, 0.07, 0.16, 1) : gfx_set(0.55, 0.57, 0.63, 1);
  text_c(pc_name(_c), _xx, _ky0 + 24 * SC, 26 * SC, 14 * SC);
  hit_add(_xx, _ky0, 26 * SC, 52 * SC, 20 + _c);
  _i += 1;
);
_by = _ky0 + _kh + 8 * SC;
button(40, 14 * SC, _by, 146 * SC, 26 * SC, "Preservar formantes", slider18 == 0);
_lt = slider20 ? "Escuchando..." : "Aprender tono";
button(41, 166 * SC, _by, 128 * SC, 26 * SC, _lt, slider20);

// perillas
_x0 = 322 * SC;
gfx_set(1, 1, 1, 0.06); gfx_line(_x0 - 8 * SC, py + 10 * SC, _x0 - 8 * SC, WH - FOOTH - 10 * SC);
section("CORRECCION", _x0, py + 6 * SC, 250 * SC);
section("TONO Y TIMBRE", _x0 + 268 * SC, py + 6 * SC, 160 * SC);
section("SALIDA", _x0 + 446 * SC, py + 6 * SC, WW - _x0 - 446 * SC - 14 * SC);
_ky = py + 98 * SC;
_kx = _x0 + 44 * SC;
slider1 < 0.5 ? strcpy(#s, "0 ms ROBOT") : sprintf(#s, "%d ms", slider1);
knob(1, _kx, _ky, 32 * SC, "Velocidad", #s, ctl_get(1), 0, 1);
_kx += 100 * SC; _kr = 22 * SC; _ks = 84 * SC;
sprintf(#s, "%d %%", slider2); knob(2, _kx, _ky, _kr, "Humanizar", #s, ctl_get(2), 0, 1); _kx += _ks;
sprintf(#s, "%d %%", slider3); knob(3, _kx, _ky, _kr, "Flex", slider3 > 0 ? #s : "Apagado", ctl_get(3), 0, slider19 != 2); _kx += _ks + 6 * SC;
sprintf(#s, "%+.1f st", slider4); knob(4, _kx, _ky, _kr, "Formantes", abs(slider4) < 0.05 ? "0.0 st" : #s, ctl_get(4), 1, 1); _kx += _ks;
sprintf(#s, "%+d st", slider5); knob(5, _kx, _ky, _kr, "Transponer", slider5 == 0 ? "0 st" : slider5 == 12 ? "+1 octava" : slider5 == -12 ? "-1 octava" : #s, ctl_get(5), 1, 1); _kx += _ks + 6 * SC;
sprintf(#s, "%d %%", slider10); knob(10, _kx, _ky, _kr, "Mezcla", #s, ctl_get(10), 0, 1); _kx += _ks;
sprintf(#s, "%+.1f dB", slider11); knob(11, _kx, _ky, _kr, "Salida", abs(slider11) < 0.05 ? "0.0 dB" : #s, ctl_get(11), 1, 1);

// ---- pie: ayuda contextual
hint_for(hover_id);
gfx_set(0.06, 0.065, 0.085, 1); gfx_rect(0, WH - FOOTH, WW, FOOTH, 1);
fnt(2); gfx_set(0.70, 0.73, 0.80, 1); text_l(#hint, 12 * SC, WH - FOOTH, FOOTH);
slider20 ? (
  acc(1);
  key_total > 0 ? sprintf(#s, "ESCUCHANDO: %s %s", pc_name(key_best), key_minor ? "menor" : "mayor") : strcpy(#s, "ESCUCHANDO...");
  text_r(#s, WW - 260 * SC, WH - FOOTH, 248 * SC, FOOTH);
) : (
  gfx_set(0.45, 0.48, 0.55, 1); sprintf(#s, "latencia %.1f ms", LAT / srate * 1000);
  text_r(#s, WW - 200 * SC, WH - FOOTH, 188 * SC, FOOTH);
);
